# Copy to .env and supply locally (never commit live values)
HOST_UID=1000
HOST_GID=1000
QUEUE_WEB_PIN_PEPPER=replace-with-existing-secret
QUEUE_WEB_SESSION_SECRET=replace-with-existing-secret
QUEUE_WEB_SECURE_COOKIE=0
SWITCHBOARD_ADDONS_NETWORK=switchboard_addons
ALLOWED_GOOGLE_EMAIL=
# Optional: set only when Queue is managed by Switchboard Admin.
# Generate separately: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
