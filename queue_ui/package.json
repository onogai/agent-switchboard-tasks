{
  "name": "nogai-queue-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run check:english && npm run check:locales && tsc -b && vite build && vite build --config vite.managed.config.ts",
    "check:english": "node scripts/checkEnglishUi.mjs",
    "check:locales": "node scripts/checkLocalePacks.mjs",
    "test:ui": "node --experimental-strip-types --test src/*.test.mjs",
    "dev": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-data-grid": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
